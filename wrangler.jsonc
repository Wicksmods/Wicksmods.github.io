{
  // Cloudflare Worker (static assets) serving wicksmods.com
  // Deploy: npx wrangler deploy   (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID)
  "name": "wicksmods-site",
  "compatibility_date": "2026-07-02",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "wicksmods.com", "custom_domain": true },
    { "pattern": "www.wicksmods.com", "custom_domain": true }
  ]
}
